{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "WebDemo",
  "rewrites": [
    { "source": "/luxury-intelligence/:path*", "destination": "http://18.221.156.51/:path*" },
    { "source": "/(.*)", "destination": "/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}

